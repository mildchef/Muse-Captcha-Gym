# Runtime data — the live training record. Curated exports for publication
# are produced deliberately (see TRAINING_LOG.md); the raw logs stay local.
data/*.jsonl
data/*.log
data/shots/

# Ephemeral tunnel address (changes on every tunnel start)
LIVE_URL.txt

# Generated corpus binaries (~340 MB) — rebuild with the tools in tools/
# (see "Corpus" in README.md).
corpus/**/*.png
corpus/**/*.jpg
corpus/**/*.jpeg
# Generated corpus manifests (outputs of the builders in tools/; the photo
# manifest's provenance is summarized in CREDITS.md)
corpus/**/*.jsonl

# Downloaded Open Images metadata CSVs (~43 MB) — regenerable from the
# URLs tabulated in corpus_staging/OPEN_IMAGES_SPIKE.md
corpus_staging/_src/oi/

# Staged dev-server runtime data (dev_staging/ smoke/e2e runs)
dev_staging/data/

# Local environment / OS noise
.env
.DS_Store
*.tmp
